<!-- SSL Certificate Placeholder -->
<svg width="200" height="120" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="sslGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#059669;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#10b981;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="200" height="120" rx="10" fill="url(#sslGrad)"/>
  <rect x="5" y="5" width="190" height="110" rx="5" fill="none" stroke="white" stroke-width="2"/>
  <text x="100" y="35" text-anchor="middle" fill="white" font-family="Arial, sans-serif" font-size="18" font-weight="bold">SSL</text>
  <text x="100" y="55" text-anchor="middle" fill="white" font-family="Arial, sans-serif" font-size="14">256-bit</text>
  <text x="100" y="75" text-anchor="middle" fill="white" font-family="Arial, sans-serif" font-size="12">Encryption</text>
  <text x="100" y="95" text-anchor="middle" fill="white" font-family="Arial, sans-serif" font-size="10">Secure Connection</text>
</svg>
